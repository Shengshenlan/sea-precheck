{
  "name": "sea-precheck",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "kb:build": "python3 kb/build_rules.py",
    "kb:verify": "tsx scripts/verify-kb.ts",
    "eval:baseline": "tsx eval/run.ts --baseline",
    "eval": "tsx eval/run.ts --api http://127.0.0.1:8788 --label local",
    "serve": "python3 -m http.server 3000 --bind 127.0.0.1 --directory out"
  },
  "dependencies": {
    "@mariozechner/pi-agent-core": "^0.73.1",
    "@mariozechner/pi-ai": "^0.73.1",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
