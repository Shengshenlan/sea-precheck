{
  "name": "sea-precheck",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "kb:build": "python3 kb/build_rules.py",
    "kb:verify": "tsx scripts/verify-kb.ts",
